# CM Collector — environment defaults
# Copy to .env and fill in your values.
# All values pre-fill interactive prompts. Press Enter to accept, or type to override.

# =============================================================================
# CMTS Environment
# =============================================================================
TACACS_PASSWORD=<your_tacacs_password>

# iCMTS
CMTS_HOST=<icmts_host_ip>
ICMTS_COMMUNITY=<snmp_community>
ICMTS_TARGET_IP=<icmts_target_ip>

# vCMTS
VCMTS_HOST=<vcmts_hostname>
VCMTS_IP=
KAFKA_BROKER=<kafka_broker_ip>:<port>
KAFKA_TOPIC=<kafka_topic>

# Jump server (leave blank if running SNMP directly from this host)
# Authenticates via SSH key (~/.ssh/id_rsa); falls back to TACACS_PASSWORD
SNMP_JUMPSERVER=<jump_server_hostname>
SNMP_USERNAME=<your_username>

# =============================================================================
# Collection settings
# =============================================================================
MODEM_COMMUNITY=<modem_snmp_community>
SNMP_POLL_INTERVAL=15
RESULTS_DIR=results
